# Copia este archivo a .env y completa los valores.
# El .env NUNCA se sube al repositorio (seccion 8 de CLAUDE.md).

# --- Base de datos ---------------------------------------------------------
POSTGRES_USER=monitor
POSTGRES_PASSWORD=cambia-esta-password
POSTGRES_DB=datacenter
# Solo se usa al correr sin Docker; en compose se arma sola apuntando al host `db`.
DATABASE_URL=postgresql+psycopg2://monitor:cambia-esta-password@localhost:5432/datacenter

# --- Seguridad -------------------------------------------------------------
# Genera la clave con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
MINUTOS_EXPIRACION_TOKEN=60

# API key del simulador / dispositivo para POST /lecturas (header X-API-Key).
# Genera otra distinta a la de JWT con el mismo comando.
DEVICE_API_KEY=

# Usuario encargado que se crea al arrancar si no existe.
# Sin estas dos variables no se crea ningun usuario (no hay credencial por defecto).
ADMIN_USER=encargado
ADMIN_PASSWORD=cambia-esta-password

# Origenes permitidos por CORS, separados por coma. Nunca usar *.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Correo de alertas (SMTP) ---------------------------------------------
# Con CORREO_HABILITADO=false el sistema corre igual y deja las alertas en el log.
CORREO_HABILITADO=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=tu-cuenta@gmail.com
# En Gmail: contrasena de aplicacion, no la del correo.
SMTP_PASSWORD=
CORREO_REMITENTE=tu-cuenta@gmail.com
CORREO_DESTINO=encargado-sala@empresa.cl
